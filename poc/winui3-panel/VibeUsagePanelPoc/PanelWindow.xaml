<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="VibeUsage.PanelPoc.PanelWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Vibe Usage">

    <!--
        The macOS new panel's layout and look (Views/Modern in vibe-usage-app),
        built in code from its constants (PanelWindow.xaml.cs, Views/*). Header
        and 概览 row on top and the footer stay put; the cards scroll when the
        screen is too short, as on the Mac. Dark only, like the Mac panel.
    -->
    <Grid x:Name="RootGrid" Language="zh-CN" RequestedTheme="Dark" KeyDown="OnRootKeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Takes focus when the panel opens by mouse, so Esc works without a focus ring. -->
        <ContentControl x:Name="FocusSink" Width="1" Height="1" Opacity="0" IsTabStop="True"
                        HorizontalAlignment="Left" VerticalAlignment="Top"
                        UseSystemFocusVisuals="False" AutomationProperties.Name="Vibe Usage 面板" />

        <Grid x:Name="HeaderHost" Grid.Row="0" />
        <Grid x:Name="SubscriptionRowHost" Grid.Row="1" />

        <ScrollViewer x:Name="Scroller" Grid.Row="2"
                      HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollMode="Auto" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ContentStack" Padding="12,0,12,0" Spacing="8" />
        </ScrollViewer>

        <Grid x:Name="FooterHost" Grid.Row="3" />
    </Grid>
</Window>
