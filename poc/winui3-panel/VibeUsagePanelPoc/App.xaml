<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="VibeUsage.PanelPoc.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!--
                Only Fluent theme resources (fonts, colours, corner radii) from
                WinUI itself: no custom fonts or palette. Elements built in code
                get these styles so they follow light/dark switches live.
            -->

            <Style x:Key="PanelCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
                <Setter Property="Padding" Value="16,12,16,12" />
            </Style>

            <Style x:Key="PanelSectionTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}" />

            <Style x:Key="PanelBodyStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}" />

            <Style x:Key="PanelBodyStrongStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}" />

            <Style x:Key="PanelBodyStrongCriticalStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
            </Style>

            <Style x:Key="PanelBodyStrongCautionStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCautionBrush}" />
            </Style>

            <Style x:Key="PanelCaptionStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}" />

            <Style x:Key="PanelCaptionSecondaryStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>

            <Style x:Key="PanelCaptionTertiaryStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
            </Style>

            <Style x:Key="PanelCaptionCriticalStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
            </Style>

            <Style x:Key="PanelCaptionCautionStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCautionBrush}" />
            </Style>

            <Style x:Key="PanelBarStyle" TargetType="ProgressBar">
                <Setter Property="Minimum" Value="0" />
                <Setter Property="Maximum" Value="100" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="PanelBarCriticalStyle" TargetType="ProgressBar" BasedOn="{StaticResource PanelBarStyle}">
                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
            </Style>

            <Style x:Key="PanelBarCautionStyle" TargetType="ProgressBar" BasedOn="{StaticResource PanelBarStyle}">
                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCautionBrush}" />
            </Style>

            <Style x:Key="PanelRingStyle" TargetType="ProgressRing">
                <Setter Property="IsIndeterminate" Value="False" />
                <Setter Property="Minimum" Value="0" />
                <Setter Property="Maximum" Value="100" />
                <Setter Property="Background" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
            </Style>

            <Style x:Key="PanelRingCriticalStyle" TargetType="ProgressRing" BasedOn="{StaticResource PanelRingStyle}">
                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
            </Style>

            <Style x:Key="PanelRingCautionStyle" TargetType="ProgressRing" BasedOn="{StaticResource PanelRingStyle}">
                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCautionBrush}" />
            </Style>

            <Style x:Key="PanelChartBarStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                <Setter Property="CornerRadius" Value="2,2,0,0" />
                <Setter Property="VerticalAlignment" Value="Bottom" />
            </Style>

            <Style x:Key="PanelDividerStyle" TargetType="Rectangle">
                <Setter Property="Fill" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <Setter Property="Height" Value="1" />
            </Style>

            <Style x:Key="PanelGlyphPathStyle" TargetType="Path">
                <Setter Property="Fill" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            </Style>

            <Style x:Key="PanelGlyphPathTertiaryStyle" TargetType="Path">
                <Setter Property="Fill" Value="{ThemeResource TextFillColorTertiaryBrush}" />
            </Style>

            <!-- Chrome-less buttons; hover and press fills come from the panel's lightweight overrides.
                 No BasedOn: the control's default style (template) always applies underneath. -->
            <Style x:Key="PanelIconButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>

            <Style x:Key="PanelTextButtonStyle" TargetType="Button">
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="8,0,10,0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>

            <Style x:Key="PanelRowButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="12,8,12,8" />
            </Style>

            <Style x:Key="SettingsCardStyle" TargetType="Border" BasedOn="{StaticResource PanelCardStyle}">
                <Setter Property="Padding" Value="16,14,16,14" />
                <Setter Property="MinHeight" Value="68" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
