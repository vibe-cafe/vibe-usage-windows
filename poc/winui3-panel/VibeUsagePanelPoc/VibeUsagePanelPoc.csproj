<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Throwaway sample (branch poc/winui3-panel, never merged): a WinUI 3 tray
    panel with fake data, built to compare against the Tauri panel on real
    machines. Unpackaged and self-contained, so the published folder runs
    without installing .NET or the Windows App SDK runtime.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RootNamespace>VibeUsage.PanelPoc</RootNamespace>
    <AssemblyName>VibeUsagePanelPoc</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>0.1.0</Version>
    <Product>Vibe Usage WinUI 3 panel sample</Product>
    <Company>Vibe Café</Company>
    <SatelliteResourceLanguages>en;zh-Hans</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- Default: the Windows App SDK metapackage (includes AI/ML/Widgets components the
       panel never uses). -p:PocSlim=true references only the WinUI components, to see
       how small a real build could be. -->
  <ItemGroup Condition="'$(PocSlim)' != 'true'">
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.7.0" />
  </ItemGroup>
  <ItemGroup Condition="'$(PocSlim)' == 'true'">
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.7.0" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" Version="2.7.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
