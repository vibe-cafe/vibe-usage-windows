<Project Sdk="Microsoft.NET.Sdk">

  <!-- Plain .NET tests for the pure parts of the sample (placement, click race);
       compiles those source files directly, no WinUI needed. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../VibeUsagePanelPoc/Shell/PanelPlacement.cs" Link="Shared/PanelPlacement.cs" />
    <Compile Include="../VibeUsagePanelPoc/Shell/TrayToggleGate.cs" Link="Shared/TrayToggleGate.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

</Project>
