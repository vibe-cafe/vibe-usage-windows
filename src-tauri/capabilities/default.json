{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities for the popover panel and settings window",
  "windows": [
    "popover",
    "settings"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:event:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "core:window:allow-is-visible",
    "core:window:allow-is-minimized"
  ]
}
