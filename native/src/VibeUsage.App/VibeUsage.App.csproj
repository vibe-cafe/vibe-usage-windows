<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The native Windows shell (WinUI 3, #85 / #92): tray icon, panel, settings
    window, single instance, start and exit. Unpackaged and self-contained:
    the published folder runs without installing .NET or the Windows App SDK
    runtime. x64 only for now (#85 decision 9). Full trimming, no Native AOT
    (#86): no reflection-based data binding, no dynamic loading, JSON through
    source generation. The shell does no networking of its own; the banned
    API list fails the build if networking types are referenced.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RootNamespace>VibeUsage.App</RootNamespace>
    <AssemblyName>vibe-usage-app</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <!-- Needed even unpackaged: builds the .pri that carries the compiled XAML (.xbf)
         and the ms-appx:/// fonts. Without it every resource lookup fails at run time. -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <WarningsAsErrors>$(WarningsAsErrors);RS0030</WarningsAsErrors>
    <Version>0.8.0</Version>
    <Product>Vibe Usage</Product>
    <Company>Vibe Café</Company>
  </PropertyGroup>

  <!-- Only the WinUI parts of the Windows App SDK: the metapackage also pulls
       AI/ML/Widgets (measured on the sample: 235 MB vs 172 MB self-contained). -->
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.7.0" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" Version="2.7.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="3.3.4" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VibeUsage.Backend\VibeUsage.Backend.csproj" />
    <ProjectReference Include="..\VibeUsage.Display\VibeUsage.Display.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\**\*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="THIRD_PARTY_NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
    <AdditionalFiles Include="BannedSymbols.txt" />
  </ItemGroup>

</Project>
