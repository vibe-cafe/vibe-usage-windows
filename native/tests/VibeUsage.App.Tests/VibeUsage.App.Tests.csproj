<Project Sdk="Microsoft.NET.Sdk">
  <!-- The shell's pure parts (open and close rules, tray retry, placement,
       click race, launch options, sync label, path markup, display mapping,
       demo data and scenes, subscription order), compiled from the app's sources: no WinUI, runs on macOS. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../src/VibeUsage.App/Shell/ShellRules.cs" Link="App/ShellRules.cs" />
    <Compile Include="../../src/VibeUsage.App/Shell/LaunchOptions.cs" Link="App/LaunchOptions.cs" />
    <Compile Include="../../src/VibeUsage.App/Shell/TrayToggleGate.cs" Link="App/TrayToggleGate.cs" />
    <Compile Include="../../src/VibeUsage.App/Shell/PanelPlacement.cs" Link="App/PanelPlacement.cs" />
    <Compile Include="../../src/VibeUsage.App/Panel/SyncLabel.cs" Link="App/SyncLabel.cs" />
    <Compile Include="../../src/VibeUsage.App/Panel/PathMarkup.cs" Link="App/PathMarkup.cs" />
    <Compile Include="../../src/VibeUsage.App/Panel/ProviderMarks.cs" Link="App/ProviderMarks.cs" />
    <Compile Include="../../src/VibeUsage.App/State/DisplayMapping.cs" Link="App/DisplayMapping.cs" />
    <Compile Include="../../src/VibeUsage.App/State/DemoBackend.cs" Link="App/DemoBackend.cs" />
    <Compile Include="../../src/VibeUsage.App/State/DemoScenes.cs" Link="App/DemoScenes.cs" />
    <Compile Include="../../src/VibeUsage.App/State/SubscriptionOrder.cs" Link="App/SubscriptionOrder.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" PrivateAssets="all" />
    <ProjectReference Include="../../src/VibeUsage.Backend/VibeUsage.Backend.csproj" />
    <ProjectReference Include="../../src/VibeUsage.Display/VibeUsage.Display.csproj" />
  </ItemGroup>
</Project>
